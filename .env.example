# production | staging (staging shows a yellow banner + noindex)
PUBLIC_SITE_ENV=production

# From defy-pay-api stack outputs (sibling repo ~/projects/defy-pay-api).
# Prefer CloudFront URL (not the raw Function URL). No trailing slash.
# Example: https://d111111abcdef8.cloudfront.net
PUBLIC_PAY_API_BASE=

# Same value as PayApiKey in defy-pay-api SAM deploy.
# Visible in site JS — deters casual scanners only; pair with CloudFront + WAF.
PUBLIC_PAY_API_KEY=
