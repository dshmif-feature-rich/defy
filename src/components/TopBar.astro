---
import { site } from '../config/site';
---

<div class="bg-defy-dark text-sm text-white">
  <div
    class="container-defy flex flex-col gap-2 py-2.5 sm:flex-row sm:items-center sm:justify-between"
  >
    <span class="tracking-wide text-white/95">{site.tagline}</span>
    <div class="flex flex-wrap items-center gap-4">
      <a
        href={`tel:${site.phoneTel}`}
        class="inline-flex min-h-11 items-center gap-1.5 text-white transition-colors hover:text-white focus-visible:underline"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
          ></path></svg
        >
        <span class="sr-only">Call us at </span>
        {site.phone}
      </a>
      <a
        href={`mailto:${site.email}`}
        class="inline-flex min-h-11 items-center gap-1.5 text-white transition-colors hover:text-white focus-visible:underline"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
            d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
        >
        <span class="sr-only">Email us at </span>
        {site.email}
      </a>
      <a
        href={site.mapUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 min-w-11 items-center justify-center gap-1.5 text-white transition-colors hover:text-white focus-visible:underline"
        aria-label="View office location on Google Maps (opens in a new tab)"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle
            cx="12"
            cy="10"
            r="3"></circle></svg
        >
      </a>
    </div>
  </div>
</div>
