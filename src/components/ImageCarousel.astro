---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alt?: string;
}

const { images, alt = 'DEFY procedure gallery' } = Astro.props;
const carouselId = `carousel-${Math.abs(
  Array.from(alt).reduce((h, c) => ((h << 5) - h + c.charCodeAt(0)) | 0, 0),
)}-${images.length}`;
---

<div
  class="carousel-root"
  data-carousel={carouselId}
  role="region"
  aria-roledescription="carousel"
  aria-label={alt}
>
  <p class="sr-only" id={`${carouselId}-status`} aria-live="polite"></p>
  <div class="relative overflow-hidden rounded-sm shadow-lg">
    <div
      class="carousel-track flex snap-x snap-mandatory overflow-x-auto scroll-smooth"
      tabindex="0"
      aria-label={`${alt} images. Use arrow keys to change slides.`}
    >
      {
        images.map((image, i) => (
          <div
            class="carousel-slide min-w-full snap-center"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${images.length}`}
          >
            <Image
              src={image}
              alt={`${alt}, image ${i + 1} of ${images.length}`}
              class="aspect-[4/3] w-full object-cover"
              widths={[400, 600, 800]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))
      }
    </div>

    {
      images.length > 1 && (
        <>
          <button
            type="button"
            class="carousel-prev absolute top-1/2 left-3 flex min-h-11 min-w-11 -translate-y-1/2 items-center justify-center rounded-full bg-defy-rose-dark p-2 text-white shadow transition-colors hover:bg-defy-dark focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
            aria-label="Previous image"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button
            type="button"
            class="carousel-next absolute top-1/2 right-3 flex min-h-11 min-w-11 -translate-y-1/2 items-center justify-center rounded-full bg-defy-rose-dark p-2 text-white shadow transition-colors hover:bg-defy-dark focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
            aria-label="Next image"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </>
      )
    }
  </div>

  {
    images.length > 1 && (
      <div
        class="carousel-dots mt-4 flex flex-wrap justify-center gap-1"
        role="group"
        aria-label="Choose slide"
      >
        {images.map((_, i) => (
          <button
            type="button"
            class="carousel-dot flex min-h-11 min-w-11 items-center justify-center rounded-full"
            aria-label={`Go to image ${i + 1} of ${images.length}`}
            aria-current={i === 0 ? 'true' : 'false'}
            data-index={i}
          >
            <span
              class="carousel-dot-visual h-2.5 w-2.5 rounded-full bg-defy-charcoal/35 transition-colors"
              aria-hidden="true"
            />
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const track = root.querySelector('.carousel-track') as HTMLElement | null;
    const slides = root.querySelectorAll('.carousel-slide');
    const dots = root.querySelectorAll('.carousel-dot');
    const prev = root.querySelector('.carousel-prev');
    const next = root.querySelector('.carousel-next');
    const status = root.querySelector('[aria-live]');
    if (!track || slides.length === 0) return;

    let index = 0;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const goTo = (i: number) => {
      index = (i + slides.length) % slides.length;
      const slide = slides[index] as HTMLElement;
      track.scrollTo({
        left: slide.offsetLeft,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
      dots.forEach((dot, di) => {
        const visual = dot.querySelector('.carousel-dot-visual');
        const active = di === index;
        visual?.classList.toggle('bg-defy-rose-dark', active);
        visual?.classList.toggle('bg-defy-charcoal/35', !active);
        dot.setAttribute('aria-current', active ? 'true' : 'false');
      });
      if (status) {
        status.textContent = `Image ${index + 1} of ${slides.length}`;
      }
    };

    prev?.addEventListener('click', () => goTo(index - 1));
    next?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(Number((dot as HTMLElement).dataset.index));
      });
    });

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(index + 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goTo(slides.length - 1);
      }
    });

    track.addEventListener('scroll', () => {
      const scrollLeft = track.scrollLeft;
      slides.forEach((slide, i) => {
        const el = slide as HTMLElement;
        if (Math.abs(el.offsetLeft - scrollLeft) < 10) {
          if (i !== index) goTo(i);
        }
      });
    });

    goTo(0);
  });
</script>

<style>
  .carousel-track {
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
</style>
