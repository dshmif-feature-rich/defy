---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubBanner from '../components/SubBanner.astro';
import pay from '../content/pages/pay.json';
import { site } from '../config/site';
import { getImage } from '../lib/images';

const bannerImage = getImage(pay.banner);
const apiBase = (import.meta.env.PUBLIC_PAY_API_BASE || '').replace(/\/$/, '');
// Browser-visible shared secret — deters casual scanners; not a true secret
const apiKey = import.meta.env.PUBLIC_PAY_API_KEY || '';
const payReady = Boolean(apiBase && apiKey);
---

<BaseLayout
  title="Pay Invoice"
  description={pay.description}
  currentPath="/pay"
>
  <SubBanner
    title={pay.bannerTitle}
    image={bannerImage}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: pay.bannerTitle },
    ]}
  />

  <section class="py-16 sm:py-20">
    <div class="container-defy">
      <div class="mx-auto max-w-lg">
        <p class="mb-8 text-center leading-relaxed text-defy-charcoal">
          {pay.intro}
        </p>

        {
          !payReady && (
            <div
              class="mb-6 rounded-lg border border-amber-800/30 bg-amber-50 px-4 py-3 text-sm text-amber-950"
              role="status"
            >
              Online invoice lookup is not configured yet. Please call{' '}
              <a href={`tel:${site.phoneTel}`} class="font-semibold underline">
                {site.phone}
              </a>{' '}
              or pay using the link in your PayPal invoice email.
            </div>
          )
        }

        <div
          id="pay-error"
          class="mb-6 hidden rounded-lg border border-red-800/30 bg-red-50 px-4 py-3 text-sm text-red-950"
          role="alert"
          aria-live="assertive"
        ></div>

        <form
          id="pay-lookup-form"
          class="space-y-5 rounded-xl border border-defy-charcoal/15 bg-white p-6 shadow-sm sm:p-8"
          novalidate
        >
          <div>
            <label
              for="invoice-number"
              class="mb-1.5 block text-sm font-medium text-defy-dark"
            >
              Invoice number
            </label>
            <input
              id="invoice-number"
              name="invoiceNumber"
              type="text"
              autocomplete="off"
              required
              maxlength="40"
              placeholder="e.g. DEFY-1001"
              aria-required="true"
              class="w-full min-h-11 rounded-lg border border-defy-charcoal/30 bg-white px-3 py-2.5 text-defy-charcoal transition focus:border-defy-rose-dark focus:ring-2 focus:ring-defy-rose-dark/30"
            />
          </div>

          <div>
            <label
              for="invoice-email"
              class="mb-1.5 block text-sm font-medium text-defy-dark"
            >
              Email on invoice
            </label>
            <input
              id="invoice-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
              placeholder="name@example.com"
              aria-required="true"
              aria-describedby="invoice-email-hint"
              class="w-full min-h-11 rounded-lg border border-defy-charcoal/30 bg-white px-3 py-2.5 text-defy-charcoal transition focus:border-defy-rose-dark focus:ring-2 focus:ring-defy-rose-dark/30"
            />
            <p id="invoice-email-hint" class="mt-1.5 text-xs text-defy-charcoal">
              Use the same email address that appears on your PayPal invoice.
            </p>
          </div>

          <button
            type="submit"
            id="pay-lookup-submit"
            class="btn-primary w-full min-h-11 px-6 py-3 text-sm disabled:cursor-not-allowed disabled:opacity-60"
            disabled={!payReady}
          >
            Look up invoice
          </button>
        </form>

        <div
          id="pay-result"
          class="mt-8 hidden rounded-xl border border-defy-charcoal/15 bg-white p-6 shadow-sm sm:p-8"
          aria-live="polite"
          tabindex="-1"
        >
          <h2 class="font-serif text-2xl text-defy-rose-dark">Invoice found</h2>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-4 border-b border-defy-charcoal/15 pb-2">
              <dt class="text-defy-charcoal">Invoice</dt>
              <dd id="result-number" class="font-medium text-defy-dark"></dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-defy-charcoal/15 pb-2">
              <dt class="text-defy-charcoal">Amount due</dt>
              <dd id="result-amount" class="font-medium text-defy-dark"></dd>
            </div>
            <div
              id="result-due-row"
              class="flex justify-between gap-4 border-b border-defy-charcoal/15 pb-2 hidden"
            >
              <dt class="text-defy-charcoal">Due date</dt>
              <dd id="result-due" class="font-medium text-defy-dark"></dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-defy-charcoal">Status</dt>
              <dd id="result-status" class="font-medium text-defy-dark"></dd>
            </div>
          </dl>

          <a
            id="pay-now-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary mt-6 w-full min-h-11 px-6 py-3 text-sm"
          >
            Pay now with PayPal
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
          <p class="mt-3 text-center text-xs text-defy-charcoal">
            You will complete payment on PayPal’s secure site. Card details never
            touch this website.
          </p>
        </div>

        <p class="mt-10 text-center text-sm text-defy-charcoal">
          Questions? Call{' '}
          <a
            href={`tel:${site.phoneTel}`}
            class="font-semibold text-defy-rose-dark underline-offset-2 hover:underline"
          >
            {site.phone}
          </a>{' '}
          or email{' '}
          <a
            href={`mailto:${site.email}`}
            class="font-semibold text-defy-rose-dark underline-offset-2 hover:underline"
          >
            {site.email}
          </a>
          .
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ apiBase, apiKey }}>
  const form = document.getElementById('pay-lookup-form');
  const errorEl = document.getElementById('pay-error');
  const resultEl = document.getElementById('pay-result');
  const submitBtn = document.getElementById('pay-lookup-submit');
  const resultNumber = document.getElementById('result-number');
  const resultAmount = document.getElementById('result-amount');
  const resultDueRow = document.getElementById('result-due-row');
  const resultDue = document.getElementById('result-due');
  const resultStatus = document.getElementById('result-status');
  const payNowLink = document.getElementById('pay-now-link');

  function showError(message) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
  }

  function clearError() {
    if (!errorEl) return;
    errorEl.textContent = '';
    errorEl.classList.add('hidden');
  }

  function formatMoney(value, currency) {
    const amount = Number(value);
    if (Number.isFinite(amount)) {
      try {
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: currency || 'USD',
        }).format(amount);
      } catch {
        /* fall through */
      }
    }
    return `${currency || 'USD'} ${value}`;
  }

  function formatStatus(status) {
    if (!status) return '';
    return status
      .toLowerCase()
      .split('_')
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearError();
    resultEl?.classList.add('hidden');

    if (!apiBase || !apiKey) {
      showError('Invoice lookup is not available right now. Please contact the office.');
      return;
    }

    const fd = new FormData(form);
    const invoiceNumber = String(fd.get('invoiceNumber') || '').trim();
    const email = String(fd.get('email') || '').trim();

    if (!invoiceNumber || !email) {
      showError('Please enter both invoice number and email.');
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Looking up…';
    }

    try {
      const res = await fetch(`${apiBase}/invoices/lookup`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-api-key': apiKey,
        },
        body: JSON.stringify({ invoiceNumber, email }),
      });

      let data = {};
      try {
        data = await res.json();
      } catch {
        data = {};
      }

      if (!res.ok) {
        if (res.status === 401 || res.status === 403) {
          showError(
            'Invoice lookup is not available right now. Please contact the office.',
          );
          return;
        }
        if (res.status === 429) {
          showError(
            data.error ||
              'Too many requests. Please wait a moment and try again.',
          );
          return;
        }
        showError(
          data.error ||
            "We couldn't find a payable invoice with those details. Check the invoice number and email, or contact the office.",
        );
        return;
      }

      if (resultNumber) resultNumber.textContent = data.invoiceNumber || invoiceNumber;
      if (resultAmount) {
        resultAmount.textContent = formatMoney(
          data.amount?.value,
          data.amount?.currency,
        );
      }
      if (resultStatus) resultStatus.textContent = formatStatus(data.status);

      if (data.dueDate && resultDue && resultDueRow) {
        resultDue.textContent = data.dueDate;
        resultDueRow.classList.remove('hidden');
      } else if (resultDueRow) {
        resultDueRow.classList.add('hidden');
      }

      if (payNowLink && data.payUrl) {
        payNowLink.href = data.payUrl;
        // Soft success landing if they return later
        try {
          sessionStorage.setItem(
            'defyPayLastInvoice',
            JSON.stringify({
              invoiceNumber: data.invoiceNumber,
              amount: data.amount,
              at: Date.now(),
            }),
          );
        } catch {
          /* ignore */
        }
      }

      resultEl?.classList.remove('hidden');
      resultEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      if (resultEl instanceof HTMLElement) {
        resultEl.focus({ preventScroll: true });
      }
    } catch {
      showError(
        'Unable to reach the payment service. Check your connection and try again, or call the office.',
      );
      errorEl?.focus?.();
    } finally {
      if (submitBtn) {
        submitBtn.disabled = !apiBase || !apiKey;
        submitBtn.textContent = 'Look up invoice';
      }
    }
  });
</script>
